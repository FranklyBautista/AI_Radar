{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-radar.local/contracts/ai-radar-signal.schema.json",
  "title": "AI Radar daily signals",
  "type": "object",
  "required": ["contract_version", "fecha", "busqueda", "senales"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Version del contrato usado para este snapshot."
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha local del snapshot diario en formato YYYY-MM-DD."
    },
    "generado_en": {
      "type": "string",
      "format": "date-time",
      "description": "Momento de generacion del snapshot, si se conoce."
    },
    "busqueda": {
      "type": "object",
      "required": ["consulta", "idioma", "criterio"],
      "additionalProperties": false,
      "properties": {
        "consulta": {
          "type": "string"
        },
        "idioma": {
          "type": "string"
        },
        "criterio": {
          "type": "string"
        }
      }
    },
    "senales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titulo",
          "fuente",
          "evidencia",
          "impacto",
          "accion",
          "estado"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "titulo": {
            "type": "string"
          },
          "fuente": {
            "type": "object",
            "required": ["nombre", "url"],
            "additionalProperties": false,
            "properties": {
              "nombre": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "fecha_publicacion": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "evidencia": {
            "type": "string"
          },
          "impacto": {
            "type": "string"
          },
          "accion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": ["nueva", "activa", "accionable", "en-seguimiento", "en-observacion"]
          },
          "etiquetas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "confianza": {
            "type": "string",
            "enum": ["alta", "media", "baja"]
          }
        }
      }
    }
  }
}
